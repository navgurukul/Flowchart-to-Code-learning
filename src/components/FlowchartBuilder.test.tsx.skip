import React from 'react';
import { render, screen, fireEvent, act } from '@testing-library/react';
import '@testing-library/jest-dom';
import { FlowchartBuilder } from './FlowchartBuilder';
import { Exercise, FlowchartNode } from '../types';
// import { AuthContext } from '../contexts/AuthContext'; // No longer needed if useAuth is mocked directly

// Mock Firebase
vi.mock('firebase/database', async (importOriginal) => {
  const actual = await importOriginal();
  return {
    ...(actual as any),
    getDatabase: vi.fn(() => ({})), // Mock getDatabase to return a dummy object
    ref: vi.fn(),
    onValue: vi.fn((ref, callback) => {
      // Immediately invoke callback with a mock snapshot (no users)
      // or simulate async behavior if needed
      callback({ val: () => ({}) }); // Mock snapshot with empty data
      return vi.fn(); // Return a mock unsubscribe function
    }),
    update: vi.fn(() => Promise.resolve()),
    serverTimestamp: vi.fn(() => ({})), // Mock serverTimestamp
  };
});

// Mock useImportFlowchart hook
vi.mock('../hooks/useImportFlowchart', () => ({
  useImportFlowchart: () => ({
    isLoading: false,
    error: null,
    chartJson: null,
    validationReport: null,
    triggerImport: vi.fn(),
    clearImportedData: vi.fn(),
  }),
}));

// Mock useAuth hook
vi.mock('../contexts/AuthContext', async (importOriginal) => {
  const actual = await importOriginal() as any;
  return {
    ...actual,
    useAuth: () => ({
      currentUser: { uid: 'test-user-uid', email: 'test@example.com', displayName: 'Test User', photoURL: null },
      loading: false,
    }),
  };
});


// Mock exercise data
const mockExercise: Exercise = {
  id: 1,
  title: 'Test Exercise',
  description: 'A test exercise for flowchart builder.',
  problemStatement: 'Create a simple flowchart.',
  sampleInput: 'N/A',
  expectedOutput: 'N/A',
  difficulty: 'beginner',
  category: 'General',
  hints: [],
};

// Mock functions
const mockOnGenerateCode = vi.fn();
const mockOnRunCode = vi.fn();

describe('FlowchartBuilder Node Dragging', () => {
  const getInitialNode = (id: string, x: number, y: number, type: FlowchartNode['type'] = 'process'): FlowchartNode => ({
    id,
    type,
    position: { x, y },
    data: { label: `${type} node` },
  });

  test('should allow a node to be dragged multiple times', async () => {
    const initialNodeId = 'node1';
    const initialPosition = { x: 100, y: 100 };
    const drag1Delta = { x: 50, y: 50 };
    const drag2Delta = { x: 30, y: -20 };

    const initialFlowchart = {
      nodes: [getInitialNode(initialNodeId, initialPosition.x, initialPosition.y)],
      edges: [],
    };

    // Actual AuthProvider will be used, but we need to mock Firebase interactions
    // if AuthProvider itself calls them directly on mount or during operations.
    // For this specific test, if FlowchartBuilder only *reads* from useAuth,
    // and AuthProvider sets up a default non-null currentUser, it might work.
    // However, the error "useAuth must be used within an AuthProvider" implies the context value is undefined.

    // Let's re-verify the import of AuthContext. It was added.
    // The issue might be that AuthContext itself is undefined at the point of testing
    // if not mocked correctly or if there's a circular dependency/mocking order issue.

    // We will mock the useAuth hook directly to provide a value.
    // This is often simpler than mocking the entire provider chain.
    // vi.mock moved to the top level of the describe block or file
    // to ensure it's applied before component rendering.

    render(
        <FlowchartBuilder
          exercise={mockExercise}
          onGenerateCode={mockOnGenerateCode}
          onRunCode={mockOnRunCode}
          isRunning={false}
          newFlowchartToLoad={initialFlowchart}
        />
    );

    // Find the canvas and the node.
    // Nodes are rendered as divs with style.left and style.top.
    // We'll find the node by its text content initially, then verify its position.
    // A more robust way would be to add data-testid to nodes if possible.
    // For now, we assume the label is unique enough for this test.

    // Wait for the node to be rendered from newFlowchartToLoad
    // The node's label is "Process node" as defined in getInitialNode
    // Using findByText with a longer timeout to ensure async updates complete.
    let nodeElement = await screen.findByText('Process node', {}, { timeout: 3000 });
    // The parent div is the draggable element. Let's make the selector more robust.
    // Nodes have a structure like: <div style="left: ... top: ..."><div title="..."><span class="truncate">LABEL</span></div></div>
    // So, we need to go up two levels from the span to get the draggable div.
    const draggableNodeDiv = nodeElement.parentElement?.parentElement;
    expect(draggableNodeDiv).toBeInTheDocument();
    expect(draggableNodeDiv).toHaveStyle(`left: ${initialPosition.x}px`);
    expect(draggableNodeDiv).toHaveStyle(`top: ${initialPosition.y}px`);


    const canvasElement = draggableNodeDiv!.parentElement as HTMLDivElement; // Assuming node is direct child of canvas
    expect(canvasElement).toHaveClass('flowchart-dots-bg'); // Verify it's the canvas

    // --- First Drag Operation ---
    // 1. MouseDown on the node
    await act(async () => {
      fireEvent.mouseDown(draggableNodeDiv!, { clientX: initialPosition.x + 5, clientY: initialPosition.y + 5 }); // Small offset within node
    });

    // 2. MouseMove on the canvas
    await act(async () => {
      fireEvent.mouseMove(canvasElement, {
        clientX: initialPosition.x + 5 + drag1Delta.x,
        clientY: initialPosition.y + 5 + drag1Delta.y,
      });
    });

    // 3. MouseUp on the canvas (or window, but canvas is easier to target here)
    await act(async () => {
      fireEvent.mouseUp(canvasElement);
    });

    // Verify node position after first drag
    const expectedPos1X = initialPosition.x + drag1Delta.x;
    const expectedPos1Y = initialPosition.y + drag1Delta.y;

    // Re-find the node element as its style (and potentially instance) might have changed
    // This check is tricky because React might re-render the element.
    // We check the style attribute.
    // After drag, the nodeElement (span) should still be there. We find its draggable parent again.
    let updatedNodeSpan = await screen.findByText('Process node');
    let updatedDraggableDiv = updatedNodeSpan.parentElement?.parentElement;
    expect(updatedDraggableDiv).toBeInTheDocument();
    expect(updatedDraggableDiv).toHaveStyle(`left: ${expectedPos1X}px`);
    expect(updatedDraggableDiv).toHaveStyle(`top: ${expectedPos1Y}px`);


    // --- Second Drag Operation ---
    // 1. MouseDown on the node again
    await act(async () => {
      fireEvent.mouseDown(updatedDraggableDiv!, { clientX: expectedPos1X + 5, clientY: expectedPos1Y + 5 });
    });

    // 2. MouseMove on the canvas
    await act(async () => {
      fireEvent.mouseMove(canvasElement, {
        clientX: expectedPos1X + 5 + drag2Delta.x,
        clientY: expectedPos1Y + 5 + drag2Delta.y,
      });
    });

    // 3. MouseUp on the canvas
    await act(async () => {
      fireEvent.mouseUp(canvasElement);
    });

    // Verify node position after second drag
    const expectedPos2X = expectedPos1X + drag2Delta.x;
    const expectedPos2Y = expectedPos1Y + drag2Delta.y;

    updatedNodeSpan = await screen.findByText('Process node');
    updatedDraggableDiv = updatedNodeSpan.parentElement?.parentElement;
    expect(updatedDraggableDiv).toBeInTheDocument();
    expect(updatedDraggableDiv).toHaveStyle(`left: ${expectedPos2X}px`);
    expect(updatedDraggableDiv).toHaveStyle(`top: ${expectedPos2Y}px`);

    // If we reach here and all assertions pass, the node remained draggable.
  });
});

